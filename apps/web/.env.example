# ---- Supabase (auth: one-time email codes) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public "Publishable key" (sb_publishable_...). Never the secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Must match Supabase Auth > "Email OTP Length" (default 6)
OTP_LENGTH=6

# ---- Database (Drizzle) ------------------------------------------------------
# Supabase > Connect > "Transaction pooler" connection string (port 6543). SERVER ONLY: never prefix with NEXT_PUBLIC_.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"

# ---- Login tracking ------------------------------------------------------------
# Every sign-in attempt is logged to the database with IP + user agent (see /privacy). Required by default:
# without DATABASE_URL, sign-in is disabled. Set to "optional" only for local experiments.
# LOGIN_TRACKING=optional
