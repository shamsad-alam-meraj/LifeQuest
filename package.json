{
  "name": "lifequest",
  "private": true,
  "version": "0.1.0",
  "description": "An AI-powered operating system for real-life progression.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lifequest/web",
    "build": "npm run build -w @lifequest/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/ai && tsc -p apps/web/tsconfig.typecheck.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "npm run start -w @lifequest/web",
    "db:generate": "npm run db:generate -w @lifequest/web",
    "db:migrate": "npm run db:migrate -w @lifequest/web",
    "check:auth": "npm run check:auth -w @lifequest/web --"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
